# Copy this file to .env (which Git ignores) and fill in real values.
# Run commands with:  uv run --env-file .env manage.py runserver

# Django — generate a key with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# httptv_client.py (the API client script)
# Get your token with:  POST /api/auth/token/  (see README). Never commit a real token.
HTTPTV_API_TOKEN=replace-with-your-api-token
HTTPTV_API_URL=http://127.0.0.1:8000/api/
